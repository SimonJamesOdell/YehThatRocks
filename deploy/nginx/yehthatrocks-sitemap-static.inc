# Serve pre-built static sitemap files directly via NGINX.
# Bypasses Next.js entirely — fast, cacheable, zero DB load.
# Files are generated by scripts/build-sitemaps.mjs into /srv/yehthatrocks/sitemaps/

location = /sitemap.xml {
    alias /srv/yehthatrocks/sitemaps/sitemap.xml;
    add_header Content-Type "application/xml; charset=utf-8";
    add_header Cache-Control "public, max-age=3600, s-maxage=86400, stale-while-revalidate=86400";
}

location ~ ^/sitemap/(.+)\.xml$ {
    alias /srv/yehthatrocks/sitemaps/$1.xml;
    add_header Content-Type "application/xml; charset=utf-8";
    add_header Cache-Control "public, max-age=3600, s-maxage=86400, stale-while-revalidate=86400";
    # Return 404 if the static file doesn't exist (fall back to Next.js would happen but
    # the sitemap builder pre-generates all known shards, so missing = doesn't exist).
    try_files $uri =404;
}
