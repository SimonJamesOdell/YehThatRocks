# =============================================================================
# facebook-browser.env — unified Facebook browser posting configuration
# Used by facebook-browser-post.js (all modes)
# =============================================================================

# --- Required ---
APP_URL=https://yehthatrocks.com
FB_BROWSER_POST_GROUP_URL=https://www.facebook.com/YehThatRocks

# --- Browser profile (reuse existing signed-in magazine profile) ---
FB_BROWSER_POST_PROFILE_DIR=/home/simon/.local/share/yehthatrocks/magazine-facebook-browser/facebook-profile

# --- Headless mode (set to 0 for debugging) ---
FB_BROWSER_POST_HEADLESS=1

# --- Database (REQUIRED for spotlight, versus, roundup modes) ---
# DATABASE_URL="mysql://user:password@host:port/yeh"

# --- Magazine mode ---
# FB_BROWSER_POST_MAGAZINE_MESSAGE_PREFIX=""   (default: just the URL)

# --- Spotlight mode ---
# FB_BROWSER_POST_SPOTLIGHT_MESSAGE_PREFIX="🎸 Track Spotlight 🎸"
# FB_BROWSER_POST_SPOTLIGHT_DEDUPE_DAYS=60

# --- Versus mode ---
# FB_BROWSER_POST_VERSUS_MESSAGE_PREFIX="⚔️ Track Battle! ⚔️"
# FB_BROWSER_POST_VERSUS_DEDUPE_DAYS=90

# --- Discussion mode ---
# FB_BROWSER_POST_DISCUSSION_MESSAGE_PREFIX="💬 Discussion Time"
# FB_BROWSER_POST_DISCUSSION_DEDUPE_DAYS=14

# --- Roundup mode ---
# FB_BROWSER_POST_ROUNDUP_MESSAGE_PREFIX="📊 This Week's Top Tracks"
# FB_BROWSER_POST_ROUNDUP_COUNT=5

# --- Trivia mode ---
# FB_BROWSER_POST_TRIVIA_MESSAGE_PREFIX="🎸 Trivia Time! 🎸"
# FB_BROWSER_POST_TRIVIA_DEDUPE_DAYS=30
