MYSQL_ROOT_PASSWORD=replace-this
MYSQL_DATABASE=yeh
MYSQL_USER=yeh
MYSQL_PASSWORD=replace-this-too

APP_PORT=3000
APP_URL=https://yehthatrocks.com
AUTH_JWT_SECRET=replace-with-a-random-32-plus-character-secret
WEB_IMAGE=ghcr.io/simonjamesodell/yehthatrocks-web:latest

# Bot-defense levers (see deploy/nginx/yehthatrocks-challenge.inc).
# Proof-of-work difficulty in leading zero bits. 24 is the default; raise to
# 28-32 during an active catalog-walker swarm — every solve then "donates"
# seconds-to-minutes of the bot's CPU. Clamped server-side to 8..40.
POW_DIFFICULTY_BITS=24
# Emergency load-shedding mode: cold clients (no valid ytr_botok cookie) are
# redirected to /challenge before any page is served. 0=off, 1=on.
ATTACK_MODE=0
# Decoy-catalog dump served to the confident catalog-walker signature
# (/artist/<slug>?letter=X&resume=1&v=<id>). 1=on, 0=off.
DECOY_DUMP_ENABLED=1
# Target size of that dump in bytes. 262144 (256KB) is the default. Watch
# egress: every 1MB here costs ~30GB/day at the walker's current request rate.
DECOY_DUMP_BYTES=262144
# Slow-drip delivery: send the decoy dump a few KB at a time so the walker's
# connection stays pinned open. 1=on, 0=off (instant dump).
DECOY_DRIP_ENABLED=1
# Bytes per drip chunk.
DECOY_DRIP_CHUNK_BYTES=4096
# Milliseconds between chunks (clamped 25..5000).
DECOY_DRIP_INTERVAL_MS=400
# Max simultaneous slow responses. Past this, fall back to the instant dump.
DECOY_DRIP_MAX_CONCURRENT=20

YOUTUBE_DATA_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GROQ_CLASSIFICATION_MODEL=openai/gpt-oss-120b
ENABLE_ARTIST_WIKI_GENERATION=1
ENABLE_MAGAZINE_GENERATION=1
ENABLE_MAGAZINE_COMMENT_GROQ=0

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@yehthatrocks.com