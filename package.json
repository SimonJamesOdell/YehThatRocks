{
  "name": "yehthatrocks",
  "private": true,
  "packageManager": "npm@11.16.0",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "prepare": "git config core.hooksPath .githooks && node -e \"const fs=require('fs'),path=require('path'); const dir='.githooks'; if(process.platform!=='win32'){try{fs.readdirSync(dir).forEach(f=>fs.chmodSync(path.join(dir,f),0o755))}catch(e){}}\"",
    "clear-cache": "node -e \"const{rmSync,existsSync}=require('fs');['apps/web/.next/dev','apps/web/.next/cache/turbopack'].forEach(p=>{if(existsSync(p)){rmSync(p,{recursive:true,force:true});console.log('removed',p)}});console.log('🧹 Next.js dev cache cleared')\"",
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "test:smoke:install": "playwright install chromium",
    "test:smoke": "npm run test:smoke:quick",
    "test:smoke:quick": "playwright test tests/smoke/core-shell.spec.ts",
    "test:api": "pwsh -NoProfile -ExecutionPolicy Bypass -File ./scripts/test-api.ps1",
    "test:smoke:full": "playwright test",
    "test:smoke:mobile": "playwright test tests/smoke/mobile-shell.spec.ts",
    "test:smoke:headed": "playwright test --headed --project=chromium",
    "tunnel:host": "powershell -ExecutionPolicy Bypass -File ./scripts/setup-ssh-tunnel-host.ps1",
    "prisma:format": "prisma format",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:status": "prisma migrate status",
    "audit:embedability": "node scripts/audit-video-embedability.js",
    "audit:genres": "node scripts/audit-genre-quality.js",
    "audit:embedability:pool": "node scripts/audit-video-embedability.js --limit=200 --concurrency=8 --exhaustive",
    "audit:embedability:all": "node scripts/audit-video-embedability.js --all --limit=1000 --concurrency=8 --exhaustive",
    "audit:catalog": "node scripts/audit-catalog-integrity.js",
    "dedupe:videos": "node scripts/prune-duplicate-videos.js",
    "dedupe:videos:apply": "node scripts/prune-duplicate-videos.js --apply",
    "dedupe:videos:enforce": "node scripts/prune-duplicate-videos.js --enforce-unique",
    "dedupe:videos:apply:enforce": "node scripts/prune-duplicate-videos.js --apply --enforce-unique",
    "scan:non-music": "node scripts/scan-non-music-candidates.js",
    "scan:non-music:review": "node scripts/scan-non-music-candidates.js --scan-all=1 --scope=all-videos --max-candidates=0 --batch-size=3000 --min-score=3",
    "scan:non-music:strict": "node scripts/scan-non-music-candidates.js --min-score=5 --max-candidates=1000",
    "scan:non-music:all": "node scripts/scan-non-music-candidates.js --scan-all=1 --max-candidates=2000 --batch-size=3000",
    "scan:non-music:every-row": "node scripts/scan-non-music-candidates.js --scan-all=1 --scope=all-videos --max-candidates=0 --batch-size=3000",
    "scan:non-music:every-row:apply-local": "node scripts/scan-non-music-candidates.js --scan-all=1 --scope=all-videos --max-candidates=0 --batch-size=3000 --apply-local=1 --confirm-delete=YES",
    "scan:non-music:build-delete-sql": "node scripts/build-non-music-delete-sql.js",
    "fix:reversed-artist-track": "node scripts/fix-reversed-artist-track.js",
    "fix:reversed-artist-track:apply": "node scripts/fix-reversed-artist-track.js --apply --confirm=SWAP_ARTIST_TRACK",
    "repair:video-metadata": "node scripts/repair-video-metadata.js",
    "repair:video-metadata:apply": "node scripts/repair-video-metadata.js --apply --confirm=REPAIR_VIDEO_METADATA",
    "prune:unavailable:all": "node scripts/audit-video-embedability.js --all --limit=1000 --concurrency=8 --exhaustive --prune-unavailable",
    "rebuild:artist-stats": "node scripts/rebuild-artist-stats.js",
    "prune:genres": "node scripts/prune-non-rock-metal-genres.js --dry-run",
    "prune:genres:apply": "node scripts/prune-non-rock-metal-genres.js --confirm=PRUNE_NON_ROCK_METAL",
    "backfill:related": "node scripts/backfill-related-links.js",
    "backfill:genres": "node scripts/backfill-genres-from-musicbrainz.js",
    "backfill:video-genres": "node scripts/backfill-video-genres.js",
    "verify:categories": "node scripts/verify-categories-invariants.js",
    "verify:categories:api": "node scripts/verify-categories-invariants.js --check-api",
    "verify:artists-ui": "node scripts/verify-artists-ui-invariants.js",
    "verify:top100-ui": "node scripts/verify-top100-ui-invariants.js",
    "verify:playlists-ui": "node scripts/verify-playlists-ui-invariants.js",
    "verify:playlists:api": "node scripts/verify-playlists-api-smoke.js",
    "verify:core-experience": "node scripts/verify-core-experience-invariants.js",
    "verify:player-core": "node scripts/verify-player-core-invariants.js",
    "verify:overlay-routing": "node scripts/verify-overlay-routing-invariants.js",
    "verify:new-videos": "node scripts/verify-new-videos-invariants.js",
    "verify:new-videos:api": "node scripts/verify-new-videos-api-smoke.js",
    "verify:core-experience:api": "node scripts/verify-core-experience-api-smoke.js",
    "verify:auth": "node scripts/verify-auth-invariants.js",
    "verify:onboarding": "node scripts/verify-onboarding-invariants.js",
    "verify:genre-preference-store": "node scripts/verify-genre-preference-store-invariants.js",
    "verify:local-only-onboarding": "node scripts/verify-local-only-onboarding-invariants.js",
    "verify:anonymous-endpoint": "node scripts/verify-anonymous-endpoint-contract.js",
    "verify:admin": "node scripts/verify-admin-invariants.js",
    "verify:favourites": "node scripts/verify-favourites-invariants.js",
    "verify:history-ui": "node scripts/verify-history-ui-invariants.js",
    "verify:watch-next-and-new": "node scripts/verify-watch-next-and-new-invariants.js",
    "verify:thumbnail-preflight": "node scripts/verify-thumbnail-preflight-invariants.js",
    "verify:hidden-videos": "node scripts/verify-hidden-videos-invariants.js",
    "verify:search": "node scripts/verify-search-invariants.js",
    "verify:classification": "node scripts/verify-classification-invariants.js",
    "verify:no-seed-fallbacks": "node scripts/verify-no-seed-fallbacks-invariants.js",
    "verify:delivery-cache": "node scripts/verify-cache-delivery-invariants.js",
    "verify:budget-guardrails": "node scripts/verify-budget-guardrails.js",
    "verify:queue-behavior": "npm -w web run test -- components/use-next-track-decision.test.ts components/use-temporary-queue-controller.component.test.tsx",
    "verify:compile": "npm run build",
    "verify:auth:api": "node scripts/verify-auth-api-smoke.js",
    "monitor:performance": "node scripts/monitor-performance.js",
    "facebook:group-share": "node scripts/facebook-group-autoshare.js",
    "facebook:group-share:dry-run": "node scripts/facebook-group-autoshare.js --dry-run",
    "reddit:subreddit-share": "node scripts/reddit-subreddit-autoshare.js",
    "reddit:subreddit-share:dry-run": "node scripts/reddit-subreddit-autoshare.js --dry-run",
    "facebook:new-video-share": "node scripts/facebook-group-new-video-share.js",
    "facebook:new-video-share:dry-run": "node scripts/facebook-group-new-video-share.js --dry-run",
    "facebook:browser-post:magazine": "node scripts/facebook-browser-post.js --mode magazine",
    "facebook:browser-post:magazine:dry-run": "node scripts/facebook-browser-post.js --mode magazine --dry-run",
    "facebook:browser-post:spotlight": "node scripts/facebook-browser-post.js --mode spotlight",
    "facebook:browser-post:spotlight:dry-run": "node scripts/facebook-browser-post.js --mode spotlight --dry-run",
    "facebook:browser-post:versus": "node scripts/facebook-browser-post.js --mode versus",
    "facebook:browser-post:versus:dry-run": "node scripts/facebook-browser-post.js --mode versus --dry-run",
    "facebook:browser-post:discussion": "node scripts/facebook-browser-post.js --mode discussion",
    "facebook:browser-post:discussion:dry-run": "node scripts/facebook-browser-post.js --mode discussion --dry-run",
    "facebook:browser-post:roundup": "node scripts/facebook-browser-post.js --mode roundup",
    "facebook:browser-post:roundup:dry-run": "node scripts/facebook-browser-post.js --mode roundup --dry-run",
    "facebook:browser-post:trivia": "node scripts/facebook-browser-post.js --mode trivia",
    "facebook:browser-post:trivia:dry-run": "node scripts/facebook-browser-post.js --mode trivia --dry-run",
    "facebook:browser-post:login": "node scripts/facebook-browser-post.js --mode magazine --login",
    "verify:magazine": "node scripts/verify-magazine-invariants.js",
    "verify:magazine-browser-flow": "node scripts/verify-magazine-browser-open-flow-invariants.js",
    "verify:magazine-comments": "node scripts/verify-magazine-comments-invariants.js",
    "verify:forum": "node scripts/verify-forum-invariants.js",
    "verify:shell-decomposition": "node scripts/verify-shell-decomposition-invariants.js",
    "verify:shared-utils": "node scripts/verify-shared-utils-invariants.js",
    "verify:mobile": "node scripts/verify-mobile-invariants.js",
    "verify:wiki": "node scripts/verify-wiki-invariants.js",
    "magazine:generate": "node scripts/generate-magazine-article.js",
    "magazine:generate:dry-run": "node scripts/generate-magazine-article.js --dry-run",
    "magazine:autogen:daily": "node scripts/magazine-news-autogen.js --count=3",
    "magazine:autogen:dry-run": "node scripts/magazine-news-autogen.js --dry-run --count=1",
    "maintain:admin-dashboard": "node scripts/maintain-admin-dashboard-cache.mjs",
    "maintain:admin-dashboard:schedule": "node scripts/schedule-admin-dashboard-maintenance.js",
    "verify:deploy-pipeline": "node scripts/verify-deploy-pipeline-invariants.js",
    "verify:ui-regressions": "npm run verify:deploy-pipeline && npm run verify:forum && npm run verify:artists-ui && npm run verify:top100-ui && npm run verify:playlists-ui && npm run verify:core-experience && npm run verify:player-core && npm run verify:overlay-routing && npm run verify:new-videos && npm run verify:categories && npm run verify:thumbnail-preflight && npm run verify:auth && npm run verify:onboarding && npm run verify:genre-preference-store && npm run verify:local-only-onboarding && npm run verify:anonymous-endpoint && npm run verify:admin && npm run verify:favourites && npm run verify:history-ui && npm run verify:watch-next-and-new && npm run verify:hidden-videos && npm run verify:search && npm run verify:classification && npm run verify:no-seed-fallbacks && npm run verify:delivery-cache && npm run verify:budget-guardrails && npm run verify:queue-behavior && npm run verify:magazine && npm run verify:magazine-browser-flow && npm run verify:magazine-comments && npm run verify:shell-decomposition && npm run verify:shared-utils && npm run verify:wiki && npm run verify:mobile",
    "verify:light": "npm run verify:forum && npm run verify:core-experience && npm run verify:player-core && npm run verify:overlay-routing && npm run verify:queue-behavior && npm run verify:wiki && npm run verify:mobile",
    "verify:invariants": "npm run verify:compile && npm run verify:ui-regressions",
    "verify:invariants:api": "npm run verify:core-experience:api && npm run verify:new-videos:api && npm run verify:playlists:api && npm run verify:categories:api && npm run verify:auth:api",
    "verify:deps:quick": "npm run test:smoke:install && npm run test:smoke:quick",
    "verify:deps-smoke": "npm run verify:deps:quick",
    "prepare:ship:light": "npm run verify:light",
    "prepare:ship:full": "npm run maintain:deps && npm run verify:invariants && npm run verify:invariants:api && npm run test:api && npm audit --audit-level=critical",
    "ship:commit": "git add -A && git commit -m \"chore: ship candidate\"",
    "ship:check-clean": "node -e \"var s=require('child_process').execSync('git status --porcelain',{encoding:'utf8'});if(s.trim()){console.error('ERROR: working tree is not clean. Commit or stash changes before shipping.');process.exit(1)}\"",
    "ship:light": "node -e \"if(require('./package.json').name!=='yehthatrocks'){console.error('ERROR: ship must be run from the yeh2 project root');process.exit(1)}\" && npm run ship:check-clean && npm run prepare:ship:light && npm run ship:commit",
    "ship:full": "node -e \"if(require('./package.json').name!=='yehthatrocks'){console.error('ERROR: ship must be run from the yeh2 project root');process.exit(1)}\" && npm run ship:check-clean && npm run prepare:ship:full && npm run ship:commit",
    "maintain:deps": "pwsh -NoProfile -ExecutionPolicy Bypass -File ./scripts/maintain-dependencies.ps1",
    "maintain:deps:install": "pwsh -NoProfile -ExecutionPolicy Bypass -File ./scripts/install-dependency-maintenance-task.ps1",
    "test:smoke:onboarding": "playwright test tests/smoke/onboarding-flow.spec.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@types/youtube": "^0.3.0",
    "cross-env": "^10.1.0",
    "prisma": "7.9.0",
    "turbo": "^2.9.18"
  },
  "overrides": {
    "sharp": "0.35.1",
    "postcss": "8.5.18"
  },
  "dependencies": {
    "@prisma/adapter-mariadb": "7.9.0",
    "@prisma/client": "7.9.0",
    "dotenv": "^17.4.2",
    "googleapis": "^159.0.0",
    "mysql2": "^3.22.5"
  }
}
